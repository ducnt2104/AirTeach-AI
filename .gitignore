# ==============================================================================
# AirTeach AI - Professional .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# C extensions
*.so

# Distribution / packaging / build artifacts
dist/
build/
*.egg-info/
.installed.cfg
*.egg
*.manifest

# Virtual Environments
.venv/
.venv*/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment and Secrets (CRITICAL: never commit actual secrets)
.env
.env.local
.env.*.local
.env.prod
.env.production
!.env.example

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Logs and runtime telemetry exports
*.log
telemetry_export*.csv
airteach_telemetry_*.csv

# SQLite temporary journals and locks (preserve data/profiles.db schema)
*.db-journal
*.db-wal
*.db-shm

# Teacher workspaces / dynamic user content
data/workspaces/*
!data/workspaces/.gitkeep
data/work/*
!data/work/.gitkeep

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Editor / IDE settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Temporary directories or nested clones
AirTeach-AI/
*.tmp
