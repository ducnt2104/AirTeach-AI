# AirTeach AI - Environment Configuration Template
# Copy this file to .env and configure your local settings
# Note: Never commit your actual .env file to public version control!

# ─── Google Gemini API ────────────────────────────────────────────────────────
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Leave blank or unconfigured to operate in 100% offline local fallback mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ─── Application Settings ─────────────────────────────────────────────────────
APP_NAME=AirTeach AI
APP_VERSION=1.0.0
DEBUG=false

# ─── Camera Settings ──────────────────────────────────────────────────────────
# 0 = default webcam, 1 = external USB camera
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# ─── Directory Paths (relative to project root) ───────────────────────────────
MODELS_DIR=models
DATA_DIR=data
