# AirTeach AI (DNT - Victer) — Environment Configuration Template
# Copy this file to `.env` and set your own Gemini API key.
# NEVER commit `.env` or real API keys to version control.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Optional Vision / CV Tuning Overrides
AIRTEACH_HAND_MIN_CONFIDENCE=0.50
AIRTEACH_QUALITY_MIN_SHARPNESS=22.0
